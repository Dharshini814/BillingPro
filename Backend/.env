
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_db
# ── Security ──────────────────────────────────────────
SECRET_KEY=vaultly-dev-secret-change-in-production-use-openssl-rand-hex-32
AUDIT_HMAC_KEY=vaultly-audit-hmac-key-change-in-production
WEBHOOK_SECRET=vaultly-webhook-secret-change-in-production

# ── AI Chatbot Configuration ─────────────────────────
# Set AI_PROVIDER to: openai, anthropic, gemini, or mock
AI_PROVIDER=mock
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4o-mini

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60